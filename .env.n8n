# n8n Environment Variables (TEMPLATE ONLY)
# AI Dream Weaver - Social Media Automation
# Do not put real passwords or keys in this file: the repository is public.
# Copy it to a local, untracked file and fill in the values there.

# n8n Authentication
N8N_USER=
N8N_PASSWORD=
N8N_HOST=localhost

# Webhook URL (update this for production)
WEBHOOK_URL=http://localhost:5678

# Re-use existing API keys from the platform
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Telegram Bot for social media posting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Execution mode
EXECUTIONS_MODE=regular
